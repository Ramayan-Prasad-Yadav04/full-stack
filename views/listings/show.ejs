<% layout("./boilerplate/boilerplate.ejs") %>

<div class="show-container">
  <h2><%= listing.title %></h2>

  <img
    src="<%= listing.image?.url || listing.image || '/images/default.jpg' %>"
    alt="<%= listing.title %>"
    class="show-img"
  />

  <div class="show-details">
    <p class="show-desc"><%= listing.description %></p>
    <p class="show-price">
      &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A"
      %> / night
    </p>
    <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
  </div>

  <!-- Buttons with gap -->
  <div class="btn-group">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-edit"
      >Edit Listing</a
    >
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button type="submit" class="btn btn-delete">Delete</button>
    </form>
  </div>
  <hr />
  <div class="create-review">
    <h1 class="review-heading">Create a Review</h1>
    <div class="reviews-form">
      <form action="/listings/<%= listing._id %>/reviews" method="post">
        <div class="form-group mb-3">
          <label for="reviewcomment"
            >Rating: <span id="range-value">3</span> / 5</label
          >
          <input
            type="range"
            name="review[rating]"
            id="reviewcomment"
            min="1"
            max="5"
            step="1"
            value="3"
            class="form-range"
            oninput="
              document.getElementById('range-value').innerText = this.value
            "
          />
        </div>

        <div class="form-group mb-3">
          <label for="reviewRating">commment:</label>
          <textarea
            name="review[comment]"
            placeholder="Write your review here..."
            id="reviewcomment"
            cols="30"
            rows="4"
            class="form-control"
          ></textarea>
        </div>

        <input type="submit" value="Submit Review" class="btn btn-primary" />
      </form>
    </div>

    <div class="show-reviews">
      <h2>Reviews</h2>
     <div>
      <% for( let review of listing.reviews ) { %>
      <p><%= review.comment %> , <%= review.rating %></p>
      <% } %>
     </div>
    </div>
  </div>
</div>
