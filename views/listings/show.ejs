<% layout("./boilerplate/boilerplate.ejs") %>

<div class="show-container">
  <h2><%= listing.title %></h2>

  <img
    src="<%= listing.image?.url || listing.image || '/images/default.jpg' %>"
    alt="<%= listing.title %>"
    class="show-img"
  />

  <div class="show-details">
    <p class="show-desc"><%= listing.description %></p>
    <p class="show-price">
      &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
    </p>
    <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
  </div>

  <!-- Buttons with gap -->
  <div class="btn-group">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-edit">Edit Listing</a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button type="submit" class="btn btn-delete">Delete</button>
    </form>
  </div>

  <hr />

  <!-- Create Review Section -->
  <div class="create-review">
    <h1 class="review-heading">Leave a review</h1>
    <div class="reviews-form">
      <form action="/listings/<%= listing._id %>/reviews" method="POST">
        <div class="form-group mb-3">
          <label for="reviewcomment">
            Rating: <span id="range-value">3</span> / 5
          </label>
          <input
            type="range"
            name="review[rating]"
            id="reviewcomment"
            min="1"
            max="5"
            step="1"
            value="3"
            class="form-range"
            oninput="document.getElementById('range-value').innerText = this.value"
          />
        </div>

        <div class="form-group mb-3">
          <label for="reviewCommentText">Comment:</label>
          <textarea
            name="review[comment]"
            placeholder="Write your review here..."
            id="reviewCommentText"
            cols="30"
            rows="4"
            class="form-control"
          ></textarea>
        </div>

        <input type="submit" value="Submit Review" class="btn btn-primary" />
      </form>
    </div>

    <!-- All Reviews Section -->
    <div class="show-reviews mt-4">
      <h2>All Reviews</h2>
      <div class="card-container">
        <% for( let review of listing.reviews ) { %>
          <div class="card mb-3 p-3 border rounded shadow-sm">
            <div class="card-body">
              <h5 class="card-user font-weight-bold">John Doe</h5>
              
              <!-- Star rating visual representation -->
              <div class="card-rating text-warning mb-2">
                <% for (let i = 1; i <= 5; i++) { %>
                  <% if (i <= review.rating) { %>
                    &#9733; <!-- Filled Star -->
                  <% } else { %>
                    &#9734; <!-- Empty Star -->
                  <% } %>
                <% } %>
                <span class="text-muted ml-2">(<%= review.rating %>/5)</span>
              </div>

              <p class="card-comment"><%= review.comment %></p>

              <!-- Delete Individual Review Button -->
              <form 
                method="POST" 
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                class="mt-2"
              >
                <button type="submit" class="btn btn-sm btn-danger">Delete Review</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>